# Server
PORT=3000

# Optional persistent storage paths for deployed hosts.
# Example Render disk mount:
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads
DATA_DIR=
UPLOAD_DIR=

# Email Sender SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password

# Slack Notification Configuration
SLACK_WEBHOOK_URL=

# WhatsApp Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
